# Copy to .env.local. With no keys at all, Aria runs in a clearly labelled rule-based demo mode
# and speaks with the browser's built-in voice.

# --- Conversation (Gemini recommended) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Retried once on overload or quota errors.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# LOW or MINIMAL. MINIMAL is marginally faster; LOW follows the guardrails a little more carefully.
GEMINI_THINKING_LEVEL=LOW
# Server speech-to-text for browsers without live recognition (Firefox) or when chosen in settings.
GEMINI_STT_MODEL=gemini-3.1-flash-lite

# --- Aria's voice ---------------------------------------------------------------
# Aria speaks with Microsoft's natural Indian voices (Neerja, Swara, Shruti, Pallavi…) through the free
# service behind Edge's Read Aloud: no key, no published quota, every browser. It is unofficial, so any
# failure falls through to the providers below, then to the browser's own voice. EDGE_TTS=0 turns it off.
EDGE_TTS=
# en-IN-NeerjaNeural or en-IN-NeerjaExpressiveNeural (other languages use their own voice automatically)
EDGE_TTS_VOICE=en-IN-NeerjaNeural
#
# The keyed providers below are backups and OPT-IN: set ENABLE_PREMIUM_VOICE=1 to add them behind Edge.
# (Opt-in because a GEMINI_API_KEY or OPENAI_API_KEY set for chat would otherwise also spend its quota on speech.)
ENABLE_PREMIUM_VOICE=
#
# Every configured provider is tried in this order: Edge → Azure → Sarvam → OpenAI → Gemini.
# Indian-language lines only go to providers that speak them (Edge, Azure, Sarvam).
# If one runs out of quota it is skipped for 10 minutes and the next one answers;
# with none left, the browser's own voice is used. Set TTS_PROVIDER to force the first choice.
TTS_PROVIDER=

# Azure AI Speech (recommended): natural Indian English voices, 500,000 characters/month free (F0 tier).
# Create a "Speech" resource in the Azure portal, then copy Key 1 and the region.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# en-IN-NeerjaNeural, en-IN-AnanyaNeural or en-IN-KavyaNeural
AZURE_TTS_VOICE=en-IN-NeerjaNeural

# Sarvam AI Bulbul: Indian voices for 11 languages (including Punjabi and Odia, which Microsoft lacks) that
# handle Hinglish well. ₹100 of free credit on sign-up (dashboard.sarvam.ai), then ₹30 per 10,000 characters.
SARVAM_API_KEY=
# bulbul:v2 has been retired.
SARVAM_TTS_MODEL=bulbul:v3
# priya, simran or ishita
SARVAM_TTS_SPEAKER=priya

# OpenAI gpt-4o-mini-tts takes separate accent instructions (paid, very cheap). Also enables OpenAI chat
# if GEMINI_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Gemini TTS (uses GEMINI_API_KEY). Free tier: about 10 requests per model per day.
# 3.x models read every prompt word aloud, so they get plain text + an en-IN locale.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_FALLBACK_MODELS=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Aoede

# --- Server ---
# Long random string. Signs per-call state; must be identical on every server instance.
# If empty, one is derived from GEMINI_API_KEY (still shared by every instance); set your own to rotate it separately.
SESSION_SECRET=
# Set to 1 to log provider error bodies (with keys redacted) while debugging.
ARIA_PROVIDER_DEBUG=

# --- Demo records and admin (features D�F) -------------------------------------
# Where post-call summaries, verified tool turns, tickets and feedback are stored.
# Defaults to ./.data. Use a writable persistent volume in production.
ARIA_DATA_DIR=
# Protects /admin. Without it, the dashboard is available in local development only
# and returns 404 in a production build. Use a long random value.
ADMIN_TOKEN=
